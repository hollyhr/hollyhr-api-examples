{
  "name": "hollyhr-api-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable examples for the HollyHR public API, webhooks and hosted MCP endpoint.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "for file in examples/*.mjs; do node --check \"$file\"; done && python3 -c \"compile(open('examples/first_call.py', encoding='utf-8').read(), 'examples/first_call.py', 'exec')\"",
    "first-call": "node examples/first-call.mjs",
    "governed-time-off": "node examples/governed-time-off-decision.mjs",
    "mcp-governed-time-off": "node examples/mcp-governed-time-off-decision.mjs",
    "mcp-whoami": "node examples/mcp-whoami.mjs",
    "paginate-people": "node examples/paginate-people.mjs",
    "python-first-call": "python3 examples/first_call.py",
    "safe-update-person": "node examples/safe-update-person.mjs",
    "verify-webhook": "node examples/verify-webhook-signature.mjs"
  },
  "dependencies": {
    "@hollyhr/api-client": "0.1.0-preview.4",
    "@modelcontextprotocol/client": "2.0.0"
  }
}
